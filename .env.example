# 資料庫連線字串（Render 的 Postgres；AICSM 的資料表一律 AICSM_ 開頭，可與其他專案共用同一個資料庫）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myapp"

# 後台登入帳密（預設 Telexpress / Telexpress）
ADMIN_USERNAME="Telexpress"
ADMIN_PASSWORD="Telexpress"

# 簽署後台登入 session cookie 用的密鑰，正式環境請換成隨機長字串
SESSION_SECRET="change-me-to-a-random-string"
